[
  {
    "$match": {
      "run_id": "REPLACE_WITH_RUN_ID"
    }
  },
  {
    "$sort": {
      "created_at": 1,
      "_id": 1
    }
  },
  {
    "$lookup": {
      "from": "experiments",
      "localField": "retrieved_experiment_ids",
      "foreignField": "_id",
      "as": "evidence"
    }
  },
  {
    "$project": {
      "_id": 1,
      "run_id": 1,
      "created_at": 1,
      "candidate": 1,
      "hypothesis": 1,
      "reason": 1,
      "policy_version": 1,
      "retrieved_experiment_ids": 1,
      "matched_evidence_count": { "$size": "$evidence" },
      "evidence": {
        "$map": {
          "input": "$evidence",
          "as": "experiment",
          "in": {
            "experiment_id": "$$experiment._id",
            "run_id": "$$experiment.run_id",
            "candidate": "$$experiment.candidate",
            "status": "$$experiment.status",
            "correct": { "$ifNull": ["$$experiment.result.correct", null] },
            "quality": { "$ifNull": ["$$experiment.result.quality", null] },
            "memory": {
              "device_peak_mib": { "$ifNull": ["$$experiment.result.memory.device_peak_mib", null] },
              "process_rss_peak_mib": { "$ifNull": ["$$experiment.result.memory.process_rss_peak_mib", null] },
              "gpu_budget_mib": { "$ifNull": ["$$experiment.result.gpu_budget_mib", null] },
              "resource_pass": { "$ifNull": ["$$experiment.result.resource_pass", null] }
            },
            "median_decode_tokens_per_second": {
              "$ifNull": ["$$experiment.result.median_decode_tokens_per_second", null]
            },
            "error": { "$ifNull": ["$$experiment.result.error", null] }
          }
        }
      }
    }
  }
]
