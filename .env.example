# Copy to .env (ignored by git). Everything is optional except what you use.

# Agent LLM, any LiteLLM model string. Unset = stock configs only, no research.
#   anthropic/claude-sonnet-5-5   (needs ANTHROPIC_API_KEY; includes web search)
#   gemini/gemini-2.5-flash       (needs GEMINI_API_KEY; includes web search)
#   ollama_chat/qwen3:8b          (local; shares your GPU, so results include its memory)
#   openai/<model>                (any OpenAI-compatible server, with OPENAI_API_BASE)
# ATLAS_LLM=
# ANTHROPIC_API_KEY=
# OPENAI_API_BASE=
# OPENAI_API_KEY=

# Optional. GitHub and Hugging Face work anonymously; a token only raises GitHub's rate limit.
# Web search comes from your LLM provider (Claude, Gemini, OpenAI, xAI), no separate key.
# GITHUB_TOKEN=

# Hugging Face token for gated models (passed into engine containers).
# HF_TOKEN=

# Optional: mirror local memory to MongoDB Atlas (also run `uv sync --extra atlas`).
# MONGODB_URI=

# Optional: where local memory lives (default ~/.atlas-tune/atlas.db).
# ATLAS_HOME=
# Optional: pin engine images, e.g. ATLAS_VLLM_IMAGE=vllm/vllm-openai:v0.11.0
# ATLAS_VLLM_IMAGE=
# ATLAS_SGLANG_IMAGE=
# ATLAS_LLAMACPP_IMAGE=
